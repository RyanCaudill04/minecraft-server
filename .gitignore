# Runtime and generated data
cache/
logs/
usercache.json
session.lock
libraries/
.paper/

# Generated dimensions and worlds. Preserve configuration separately.
/world*/

# Downloaded server and plugin binaries are reproducible artifacts.
*.jar
lazymc

# Go binaries cross-compiled on the Mac for the Pi
bin/

# Machine-specific secrets and local overrides
server.properties.local
server.properties
connection.private.md
# Host config and secrets live in ~/.config/minecraft; never commit a copy
# (the tracked examples are deploy/host.example.env and secrets.example.env).
host.env
secrets.env
*.pem
*.key
id_*

# Plugins
plugins/Chunky/tasks/
plugins/spark/tmp/*.tmp
plugins/spark/activity.json

# Personal planning notes stay local; they are not for the public repo
docs/
