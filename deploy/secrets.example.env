# Per-host settings and secrets, kept outside git. Copy this file to
# ~/.config/minecraft/secrets.env on the host, fill it in, and run
#   chmod 600 ~/.config/minecraft/secrets.env
#   systemctl --user restart admin
# systemd reads this file only when a unit starts, so restart admin after
# every change.
# Only the units that need it load it (admin.service), so play and the
# static sites never see it.

# Cloudflare Access application in front of admin.ryancaudill.dev. Neither
# value is secret, but both are per host. Until both are set, admin answers
# every request with 503.
# Team domain: Zero Trust > Settings > Team name and domain.
ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# Audience tag: Zero Trust > Access > Applications > (admin) > Overview.
ACCESS_AUD=

# scripts/install.sh creates secrets.env from this file with mode 0600 if
# it's missing. Apps read these from the environment, never from flags, so
# they don't show up in ps.

# Paper's RCON password. install.sh generates one if this is empty and
# copies it into server.properties (rcon.password), so it is only typed
# here. RCON itself stays off until enable-rcon=true (see #28).
RCON_PASSWORD=

# Planned, not read by anything yet:
# GitHub token for deploy reporting and higher API rate limits (#10).
#GITHUB_TOKEN=
# Cloudflare API token for dynamic DNS (#19).
#CLOUDFLARE_API_TOKEN=
