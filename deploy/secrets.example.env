# Per-host settings and secrets, kept outside git. Copy this file to
# ~/.config/minecraft/secrets.env on the host, fill it in, and run
#   chmod 600 ~/.config/minecraft/secrets.env
# Only the units that need it load it (admin.service), so play and the
# static sites never see it.

# Cloudflare Access application in front of admin.ryancaudill.dev. Neither
# value is secret, but both are per host, and admin won't start without them.
# Team domain: Zero Trust > Settings > Team name and domain.
ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# Audience tag: Zero Trust > Access > Applications > (admin) > Overview.
ACCESS_AUD=
