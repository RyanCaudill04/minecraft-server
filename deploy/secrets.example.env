# Per-host settings and secrets, kept outside git. Copy this file to
# ~/.config/minecraft/secrets.env on the host, fill it in, and run
#   chmod 600 ~/.config/minecraft/secrets.env
#   systemctl --user restart admin
# systemd reads this file only when a unit starts, so restart admin after
# every change (ddns.timer starts ddns.service fresh every run).
# Only the units that need it load it (admin.service and ddns.service), so
# play and the static sites never see it. systemd doesn't strip comments at
# the end of a line, so keep comments on their own lines.

# Cloudflare Access application in front of admin.ryancaudill.dev. Neither
# value is secret, but both are per host. Until both are set, admin answers
# every request with 503.
# Team domain: Zero Trust > Settings > Team name and domain.
ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# Audience tag: Zero Trust > Access > Applications > (admin) > Overview.
ACCESS_AUD=

# RCON, for admin's console. The same long random password as rcon.password
# in ~/minecraft_server/server.properties. Without it the console is off.
RCON_PASSWORD=

# Dynamic DNS (ddns.timer). Until all three are set, ddns logs that it isn't
# configured and does nothing.
# API token with Zone > DNS > Edit on this zone only.
CLOUDFLARE_DNS_TOKEN=
# From the zone's overview page in Cloudflare.
CLOUDFLARE_ZONE_ID=
# The existing A record, e.g. mc.example.com.
DDNS_RECORD=
