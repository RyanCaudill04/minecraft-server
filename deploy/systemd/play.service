# User unit for play.ryancaudill.dev: the dashboard and its JSON API.
# Installed by mc-agent from the active release (~/apps/current); world and
# player data are read from the Minecraft server folder.

[Unit]
Description=play.ryancaudill.dev dashboard

[Service]
# Defaults, overridden by host.env (see deploy/host.example.env).
Environment=SERVER_DIR=%h/minecraft_server
Environment=PLAY_ADDR=127.0.0.1:8082
EnvironmentFile=-%h/.config/minecraft/host.env
ExecStart=%h/apps/current/bin/play -dir %h/apps/current/sites/play -shared %h/apps/current/sites/shared -server ${SERVER_DIR} -addr ${PLAY_ADDR}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
