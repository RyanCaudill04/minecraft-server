# User unit for admin.ryancaudill.dev: the admin page and its JSON API.
# Installed by mc-agent from the active release (~/apps/current); deploy
# state is read from ~/apps. Cloudflare Access sits in front of it.

[Unit]
Description=admin.ryancaudill.dev dashboard

[Service]
# Defaults, overridden by host.env (see deploy/host.example.env). Secrets
# come from secrets.env (see deploy/secrets.example.env); only admin loads it.
Environment=ADMIN_ADDR=127.0.0.1:8081
EnvironmentFile=-%h/.config/minecraft/host.env
EnvironmentFile=-%h/.config/minecraft/secrets.env
ExecStart=%h/apps/current/bin/admin -dir %h/apps/current/sites/admin -shared %h/apps/current/sites/shared -apps %h/apps -addr ${ADMIN_ADDR}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
